---
// Her aktörün kendi sayfası (/tekmerler/netzero-tekmer).
import type { GetStaticPaths } from "astro";
import AktorDetay from "../../components/detay/AktorDetay.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAktorGruplari, kategoriYolu, kisaOzet, type Aktor, type Kategori } from "../../lib/content";

export const getStaticPaths = (async () => {
  const gruplar = await getAktorGruplari();
  return gruplar.flatMap(({ kategori, aktorler }) =>
    aktorler.map((aktor) => ({
      params: { kategori: kategori.data.yol, aktor: aktor.id },
      props: { aktor, kategori },
    })),
  );
}) satisfies GetStaticPaths;

interface Props {
  aktor: Aktor;
  kategori: Kategori;
}
const { aktor, kategori } = Astro.props;
---

<BaseLayout title={aktor.data.ad} description={kisaOzet(aktor.body) ?? kategori.data.aciklama}>
  <nav class="geri" aria-label="Konum">
    <a href={kategoriYolu(kategori)}>← {kategori.data.baslik ?? kategori.data.ad}</a>
  </nav>
  <div class="kutu">
    <AktorDetay aktor={aktor} kategori={kategori} />
  </div>
</BaseLayout>

<style>
  .geri { font-size: 14px; margin-bottom: 14px; }
  .geri a { text-decoration: none; }
  .geri a:hover { text-decoration: underline; }
  .kutu {
    max-width: 760px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 24px;
  }
  @media (max-width: 520px) { .kutu { padding: 18px 16px; } }
</style>
