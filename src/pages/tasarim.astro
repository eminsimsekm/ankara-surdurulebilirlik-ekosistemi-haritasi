---
// Tasarım token'larının canlı önizlemesi: tema düğmesiyle açık/koyu karşılaştırmak için.
// Kategori ve iş birliği renkleri içerikten okunur; token'ı eksik olan kayıt boş kutu olarak görünür.
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const bySira = <T extends { data: { sira: number } }>(a: T, b: T) => a.data.sira - b.data.sira;
const kategoriler = (await getCollection("kategoriler")).sort(bySira);
const isbirligiTurleri = (await getCollection("isbirligiTurleri")).sort(bySira);

const groups: { title: string; tokens: { name: string; label?: string }[] }[] = [
  { title: "Yüzey ve metin", tokens: ["--bg", "--surface", "--ink", "--muted", "--line", "--accent", "--on-accent", "--soft", "--band"].map((name) => ({ name })) },
  { title: "Kategoriler", tokens: kategoriler.map((k) => ({ name: `--c-${k.id}`, label: k.data.ad })) },
  { title: "İş birliği türleri", tokens: isbirligiTurleri.map((t) => ({ name: `--c-ib-${t.id}`, label: t.data.ad })) },
  { title: "Durum", tokens: ["--ok", "--warn", "--off"].map((name) => ({ name })) },
];

const fonts = [
  { token: "--f-display", sample: "Ankara Sürdürülebilirlik Haritası", style: "font-weight:800;font-stretch:85%;font-size:28px" },
  { token: "--f-body", sample: "Gezegen sağlığı, iklim direnci ve döngüsel ekonomi — ğüşıöç ĞÜŞİÖÇ", style: "font-size:15px" },
  { token: "--f-mono", sample: "22–23 EKİ · 3.000+ · $331 mn", style: "font-size:13px;letter-spacing:.06em" },
];
---

<BaseLayout title="Tasarım token'ları" description="Sitenin renk ve yazı tipi token'ları." tekDil>
  <header>
    <div class="eyebrow">Stil rehberi</div>
    <h1>Tasarım token'ları</h1>
    <p class="lede">Tüm değerler <code>src/styles/tokens.css</code> dosyasından gelir. Sağ üstteki düğmeyle açık ve koyu temayı karşılaştırın.</p>
  </header>

  {groups.map((g) => (
    <section>
      <h2>{g.title}</h2>
      <ul class="swatches">
        {g.tokens.map((t) => (
          <li>
            <span class="chip" style={`background:var(${t.name})`} />
            <span class="name">
              {t.label && <span>{t.label}</span>}
              <code>{t.name}</code>
            </span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section>
    <h2>Yazı tipleri</h2>
    <ul class="fonts">
      {fonts.map((f) => (
        <li>
          <code>{f.token}</code>
          <span style={`font-family:var(${f.token});${f.style}`}>{f.sample}</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  section { margin-top: 36px; }
  h2 { font-size: 20px; padding-bottom: 8px; border-bottom: 2px solid var(--ink); }
  .swatches {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 10px;
  }
  .swatches li {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 8px 10px;
  }
  .chip {
    width: 28px;
    height: 28px;
    border-radius: var(--r-sm);
    border: 1px solid var(--line);
    flex: none;
  }
  .name { display: grid; font-size: 13px; line-height: 1.3; min-width: 0; }
  code { font: 12px var(--f-mono); color: var(--muted); overflow-wrap: anywhere; }
  .fonts { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 14px; }
  .fonts li { display: grid; gap: 4px; }
</style>
