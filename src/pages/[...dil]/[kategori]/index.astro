---
// Her aktör kategorisi için liste sayfası (/teknoparklar, /tekmerler, …).
import type { GetStaticPaths } from "astro";
import FiltreCipleri from "../../../components/FiltreCipleri.astro";
import AktorSatiri from "../../../components/satirlar/AktorSatiri.astro";
import PageHeader from "../../../components/PageHeader.astro";
import SearchBox from "../../../components/SearchBox.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { alanSayilari, getAktorGruplari, kategoriBasligi, type AktorGrubu } from "../../../lib/content";
import { dilParametresi, DILLER } from "../../../lib/dil";
import { sayfaDili } from "../../../lib/yol";
import { metinler } from "../../../i18n";

export const getStaticPaths = (async () => {
  const yollar = await Promise.all(
    DILLER.map(async (dil) =>
      (await getAktorGruplari(dil)).map((grup) => ({
        params: { dil: dilParametresi(dil), kategori: grup.kategori.data.yol },
        props: grup,
      })),
    ),
  );
  return yollar.flat();
}) satisfies GetStaticPaths;

type Props = AktorGrubu;
const { kategori, aktorler } = Astro.props;
const dil = sayfaDili(Astro.url);
const t = metinler(dil);
const k = kategori.data;
const baslik = kategoriBasligi(kategori);
// Tek alanlı kategoride çip anlamsız; en az iki farklı alan varsa gösterilir
const alanlar = await alanSayilari(aktorler, dil);
---

<BaseLayout title={baslik} description={k.aciklama}>
  <div data-filter-root>
    <PageHeader baslik={baslik} ust={`${aktorler.length} ${t.birim.kayit(aktorler.length)}`} lede={k.aciklama}>
      <SearchBox etiket={t.kategoriSayfasi.ara(baslik)} placeholder={t.kategoriSayfasi.araOrnek} />
    </PageHeader>

    {alanlar.length >= 2 && (
      <FiltreCipleri
        etiket={t.filtre.alanFiltresi}
        parametre="alan"
        tumuSayi={aktorler.length}
        secenekler={alanlar.map(({ alan, sayi }) => ({ deger: alan.id, ad: alan.data.ad, sayi }))}
      />
    )}

    <ul class="liste">
      {aktorler.map((aktor) => <AktorSatiri aktor={aktor} kategori={kategori} />)}
    </ul>
    <p class="empty" data-filter-empty hidden>{t.kategoriSayfasi.bos}</p>
  </div>
</BaseLayout>

<style>
  .liste { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--ink); }
</style>
