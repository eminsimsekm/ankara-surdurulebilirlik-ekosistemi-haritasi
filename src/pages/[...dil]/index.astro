---
import OneCikanSayilar from "../../components/bloklar/OneCikanSayilar.astro";
import Harita from "../../components/harita/Harita.astro";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { dilYollari } from "../../lib/dil";
import { sayfaDili } from "../../lib/yol";
import { metinler } from "../../i18n";

export const getStaticPaths = dilYollari;
const dil = sayfaDili(Astro.url);
const t = metinler(dil);
---

<BaseLayout title={t.siteAdi}>
  <PageHeader baslik={t.siteAdi} ust={t.anaSayfaUst} />
  <OneCikanSayilar />
  <Harita />
</BaseLayout>
