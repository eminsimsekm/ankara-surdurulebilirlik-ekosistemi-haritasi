---
import FiltreCipleri from "../../components/FiltreCipleri.astro";
import PageHeader from "../../components/PageHeader.astro";
import SearchBox from "../../components/SearchBox.astro";
import TakvimSatiri from "../../components/satirlar/TakvimSatiri.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getKategoriler, getSayfa, getTakvim, idSozlugu } from "../../lib/content";
import { bugun, isoGun, takvimDurumu, takvimSiralamasi } from "../../lib/takvim";
import { dilYollari } from "../../lib/dil";
import { sayfaDili } from "../../lib/yol";
import { metinler } from "../../i18n";

export const getStaticPaths = dilYollari;
const dil = sayfaDili(Astro.url);
const t = metinler(dil);

const [sayfa, kayitlar, kategoriler] = await Promise.all([
  getSayfa("takvim", dil),
  getTakvim(dil),
  getKategoriler(dil).then(idSozlugu),
]);

// İlk sıralama build tarihine göre; tarayıcı aşağıdaki script'le güncel tarihe göre yeniden sıralar.
const tarih = bugun();
const sirala = (k: (typeof kayitlar)[number]) => {
  const baslangic = isoGun(k.data.baslangic);
  return { kod: takvimDurumu({ ...k.data, baslangic, bitis: isoGun(k.data.bitis) }, tarih, dil).kod, baslangic };
};
const sirali = [...kayitlar].sort((a, b) => takvimSiralamasi(sirala(a), sirala(b)));

const turler = [...new Set(kayitlar.map((k) => k.data.tur))].map((id) => kategoriler.get(id)!);
const { baslik, ozet } = sayfa.data;
---

<BaseLayout title={baslik} description={ozet}>
  <div data-filter-root>
    <PageHeader baslik={baslik} ust={`${kayitlar.length} ${t.birim.kayit(kayitlar.length)}`} lede={ozet}>
      <SearchBox etiket={t.takvim.ara} placeholder={t.takvim.araOrnek} />
    </PageHeader>

    <FiltreCipleri
      etiket={t.filtre.turFiltresi}
      parametre="tur"
      tumuSayi={kayitlar.length}
      secenekler={turler.map((k) => ({
        deger: k.id,
        ad: k.data.ad,
        sayi: kayitlar.filter((x) => x.data.tur === k.id).length,
        renk: `--c-${k.id}`,
      }))}
    />

    <ul class="liste" data-takvim-listesi>
      {sirali.map((kayit) => <TakvimSatiri kayit={kayit} kategori={kategoriler.get(kayit.data.tur)!} />)}
    </ul>
    <p class="empty" data-filter-empty hidden>{t.takvim.bos}</p>
  </div>
</BaseLayout>

<style>
  .liste { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
</style>

<script>
  // Durumlar güncel tarihe göre yeniden hesaplandıktan sonra (takvim-durum) açık olanlar üste gelsin.
  import "../../scripts/takvim-durum";
  import { takvimSiralamasi, type DurumKodu } from "../../lib/takvim";

  const liste = document.querySelector<HTMLElement>("[data-takvim-listesi]");
  if (liste) {
    const sirala = (li: HTMLElement) => ({
      kod: (li.querySelector<HTMLElement>("[data-durum]")?.dataset.durum ?? "kapandi") as DurumKodu,
      baslangic: li.dataset.baslangic ?? "",
    });
    [...liste.querySelectorAll<HTMLElement>(":scope > li")]
      .sort((a, b) => takvimSiralamasi(sirala(a), sirala(b)))
      .forEach((li) => liste.append(li));
  }
</script>
