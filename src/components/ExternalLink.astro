---
// Site dışına giden bağlantı: yeni sekmede açılır, metnin sonuna ↗ eklenir.
import { metinler } from "../i18n";
import { sayfaDili } from "../lib/yol";

interface Props {
  href: string;
  class?: string;
}
const { href, class: className } = Astro.props;
---

<a href={href} class={className} target="_blank" rel="noopener"><slot>{metinler(sayfaDili(Astro.url)).ortak.kaynak}</slot> ↗</a>
