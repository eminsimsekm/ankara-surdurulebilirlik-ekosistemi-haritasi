---
import type { Kategori, TakvimKaydi } from "../../lib/content";
import { tarihAraligi } from "../../lib/takvim";
import ExternalLink from "../ExternalLink.astro";
import TakvimDurumu from "../TakvimDurumu.astro";
import DetayKabuk from "./DetayKabuk.astro";
import { metinler } from "../../i18n";
import { sayfaDili } from "../../lib/yol";

interface Props {
  kayit: TakvimKaydi;
  kategori: Kategori;
  baslikSeviyesi?: "h1" | "h2" | "h3";
  /** Haritada: başlık kaydın sayfasındaki satırına bağlantı olur */
  sayfaYolu?: string;
}
const { kayit, kategori, baslikSeviyesi, sayfaYolu } = Astro.props;
const d = kayit.data;
const dil = sayfaDili(Astro.url);
const t = metinler(dil);
---

<DetayKabuk
  kategoriId={kategori.id}
  kategoriAdi={kategori.data.ad}
  baslik={d.ad}
  altBaslik={d.duzenleyen}
  baslikYolu={sayfaYolu}
  baslikSeviyesi={baslikSeviyesi}
>
  <dl class="kv">
    <dt>{t.takvim.tarih}</dt><dd>{tarihAraligi(d.baslangic, d.bitis, dil)}</dd>
    <dt>{t.takvim.durum}</dt><dd><TakvimDurumu kayit={kayit} /></dd>
  </dl>
  <div class="aciklama"><p>{d.aciklama}</p></div>
  {d.kaynak && <p class="src"><ExternalLink href={d.kaynak} /></p>}
</DetayKabuk>
