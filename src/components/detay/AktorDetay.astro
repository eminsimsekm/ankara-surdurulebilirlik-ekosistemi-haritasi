---
// Bir aktörün bilgileri. Aktör sayfasında tamamı, haritanın yan panelinde özeti (ozet) gösterilir.
import { render } from "astro:content";
import { aktorAlanlari, type Aktor, type Kategori } from "../../lib/content";
import AlanBaglantilari from "../AlanBaglantilari.astro";
import ExternalLink from "../ExternalLink.astro";
import Tags from "../Tags.astro";
import DetayKabuk from "./DetayKabuk.astro";
import { metinler } from "../../i18n";
import { sayfaDili } from "../../lib/yol";

interface Props {
  aktor: Aktor;
  kategori: Kategori;
  baslikSeviyesi?: "h1" | "h2" | "h3";
  /** Haritada: başlık aktörün kendi sayfasına bağlantı olur */
  sayfaYolu?: string;
  /**
   * Haritanın yan paneli için kısa hâl: açıklama, alanlar ve etiketler. Yönetim, firmalar,
   * uzmanlık gibi uzun bölümler yalnızca aktörün kendi sayfasında; panelde oraya bağlantı verilir.
   */
  ozet?: boolean;
}
const { aktor, kategori, baslikSeviyesi, sayfaYolu, ozet = false } = Astro.props;
const d = aktor.data;
const k = kategori.data;
const dil = sayfaDili(Astro.url);
const t = metinler(dil);
const { Content } = await render(aktor);
const alanlar = await aktorAlanlari(aktor, dil);
---

<DetayKabuk
  kategoriId={kategori.id}
  kategoriAdi={k.ad}
  baslik={d.ad}
  baslikYolu={sayfaYolu}
  altBaslik={d.konum}
  baslikSeviyesi={baslikSeviyesi}
>
  <div class="aciklama"><Content /></div>

  {(alanlar.length > 0 || (!ozet && (d.uzmanlik || d.surdurulebilirlik))) && (
    <dl class="kv">
      {alanlar.length > 0 && <><dt>{t.aktor.alan}</dt><dd><AlanBaglantilari aktor={aktor} /></dd></>}
      {!ozet && d.uzmanlik && <><dt>{t.aktor.uzmanlik}</dt><dd>{d.uzmanlik}</dd></>}
      {!ozet && d.surdurulebilirlik && <><dt>{t.aktor.surdurulebilirlik}</dt><dd>{d.surdurulebilirlik}</dd></>}
    </dl>
  )}

  {ozet ? null : d.yonetim?.length ? (
    <section>
      <h4 class="cat">{t.aktor.yonetim}</h4>
      <ul class="yonetim">
        {d.yonetim.map((y) => (
          <li>
            <b>{y.ad}</b>
            <span class="rol">{y.rol}</span>
            {y.ozgecmis && <span>{y.ozgecmis} </span>}
            {y.kaynak && <ExternalLink href={y.kaynak} />}
          </li>
        ))}
      </ul>
    </section>
  ) : (
    k.yonetimBekleniyor && <p class="sub">{t.aktor.yoneticiYok}</p>
  )}

  {!ozet && d.capaFirmalar && (
    <section>
      <h4 class="cat">{t.aktor.capaFirmalar}</h4>
      <p class="capa">
        {d.capaFirmalar.firmalar.join(", ")}
        {d.capaFirmalar.not && <span class="sub"> · {d.capaFirmalar.not}</span>}
        {d.capaFirmalar.kaynak && <> <ExternalLink href={d.capaFirmalar.kaynak} /></>}
      </p>
    </section>
  )}

  {!ozet && d.firmalar && (
    <section>
      <h4 class="cat">{k.firmaBasligi}</h4>
      {d.firmalar.length ? (
        <ul class="firmalar">{d.firmalar.map((f) => <li>{f}</li>)}</ul>
      ) : (
        <p class="sub">{t.aktor.firmaYok}</p>
      )}
    </section>
  )}

  {!ozet && d.kisiler && (
    <dl class="kv"><dt>{t.aktor.kisiler}</dt><dd>{d.kisiler}</dd></dl>
  )}

  <Tags etiketler={d.etiketler} />

  {!ozet && d.kaynak && <p class="src"><ExternalLink href={d.kaynak} /></p>}

  {ozet && sayfaYolu && <p class="devami"><a href={sayfaYolu}>{t.ortak.tumAyrintilar}</a></p>}
</DetayKabuk>

<style>
  .yonetim { list-style: none; padding: 0; margin: 8px 0 4px; display: grid; gap: 10px; }
  .yonetim li { border-left: 2px solid var(--line); padding-left: 10px; font-size: 13.5px; }
  .yonetim b { font-weight: 600; }
  .yonetim .rol { color: var(--muted); font-size: 12.5px; display: block; }
  .capa { font-size: 13.5px; margin: 6px 0 0; }
  .firmalar { margin: 8px 0 0; padding-left: 18px; font-size: 14px; }
  .devami { margin: 14px 0 0; font-size: 14px; font-weight: 600; }
</style>
