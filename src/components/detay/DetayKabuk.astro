---
/*
  Tüm detay görünümlerinin ortak kabuğu: kategori etiketi, başlık, alt satır ve
  içerik için ortak stiller. İçerik bileşenleri (AktorDetay, AkademisyenDetay…)
  aşağıdaki sınıfları kullanır: .cat .aciklama .kv .sub .src
*/
interface Props {
  kategoriId: string;
  kategoriAdi: string;
  baslik: string;
  /** Verilirse başlık bu sayfaya bağlantı olur (ör. haritadan kaydın kendi sayfasına) */
  baslikYolu?: string;
  altBaslik?: string;
  /** Kendi sayfasında h1, harita panelinde h2 */
  baslikSeviyesi?: "h1" | "h2" | "h3";
}
const { kategoriId, kategoriAdi, baslik, baslikYolu, altBaslik, baslikSeviyesi = "h1" } = Astro.props;
const Baslik = baslikSeviyesi;
---

<article class="detay" style={`--c:var(--c-${kategoriId})`}>
  <div class="cat">{kategoriAdi}</div>
  <Baslik class="ad">{baslikYolu ? <a href={baslikYolu}>{baslik}</a> : baslik}</Baslik>
  {altBaslik && <div class="alt">{altBaslik}</div>}
  <slot />
</article>

<style>
  .detay { display: grid; gap: 4px; min-width: 0; }
  .detay :global(.cat) {
    font: 500 12px var(--f-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--c);
    margin: 0;
  }
  .detay :global(section .cat) { margin-top: 10px; }
  .ad { font-size: 26px; margin: 2px 0 0; }
  h1.ad { font-size: clamp(28px, 4.5vw, 42px); }
  .ad a { color: inherit; text-decoration: none; }
  .ad a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px; }
  .alt { color: var(--muted); font-size: 13px; }

  .detay :global(.aciklama) { margin: 8px 0; }
  .detay :global(.aciklama p) { margin: 0 0 8px; }
  .detay :global(.aciklama p:last-child) { margin-bottom: 0; }

  .detay :global(.kv) { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; font-size: 14px; margin: 8px 0; }
  .detay :global(.kv dt) { color: var(--muted); font-size: 13px; }
  .detay :global(.kv dd) { margin: 0; min-width: 0; }

  .detay :global(.sub) { margin: 4px 0 0; }
  .detay :global(.src) {
    font-size: 13px;
    margin: 12px 0 0;
    word-break: break-word;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
</style>
