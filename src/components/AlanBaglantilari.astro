---
// Bir kurumun faaliyet alanları. Birincil alan, Kurumlar sayfasını o alana süzülmüş açan bağlantıdır;
// ikincil alanlar yalnızca bilgidir (filtre ve sayım birincil alana göre, bkz. birincilAlanId).
// Etiketlerden (Tags) görsel olarak ayrışır: etiket serbest ayrıntı, alan kontrollü liste.
import { aktorAlanlari, alanYolu, birincilAlanId, type Aktor } from "../lib/content";

interface Props {
  aktor: Aktor;
}
const { aktor } = Astro.props;
const alanlar = await aktorAlanlari(aktor);
const birincil = birincilAlanId(aktor);
---

{alanlar.length > 0 && (
  <ul class="alanlar">
    {alanlar.map((alan) =>
      alan.id === birincil ? (
        <li><a href={alanYolu(alan)} title={`${alan.data.ad} alanındaki tüm kurumlar`}>{alan.data.ad}</a></li>
      ) : (
        <li><span title="İkincil alan">{alan.data.ad}</span></li>
      ),
    )}
  </ul>
)}

<style>
  .alanlar { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .alanlar a,
  .alanlar span {
    display: block;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    padding: 1px 8px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: var(--r-pill);
    text-decoration: none;
  }
  .alanlar a { color: var(--accent); }
  .alanlar a:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }
  /* İkincil alan: bağlantı değil, daha soluk */
  .alanlar span { color: var(--muted); font-weight: 500; border-style: dashed; border-color: var(--line); }
</style>
