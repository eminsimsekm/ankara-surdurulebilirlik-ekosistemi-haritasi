---
// Bir kurumun faaliyet alanları; her biri Kurumlar sayfasını o alana süzülmüş açar.
// Etiketlerden (Tags) görsel olarak ayrışır: etiket bilgi, alan filtre bağlantısı.
import { alanYolu, type Alan } from "../lib/content";

interface Props {
  alanlar: readonly Alan[];
}
const { alanlar } = Astro.props;
---

{alanlar.length > 0 && (
  <ul class="alanlar">
    {alanlar.map((alan) => (
      <li><a href={alanYolu(alan)} title={`${alan.data.ad} alanındaki tüm kurumlar`}>{alan.data.ad}</a></li>
    ))}
  </ul>
)}

<style>
  .alanlar { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .alanlar a {
    display: block;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    padding: 1px 8px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: var(--r-pill);
    color: var(--accent);
    text-decoration: none;
  }
  .alanlar a:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }
</style>
