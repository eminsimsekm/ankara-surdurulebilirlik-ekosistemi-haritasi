---
// Açık/koyu tema düğmesi. Seçim localStorage'da tutulur; seçim yoksa sistem tercihi geçerlidir.
// Sayfa ilk boyanmadan önce temayı uygulayan satır içi script BaseLayout'un <head>'inde.
// Düğme metinleri sayfanın dilinde data-* ile gelir; script dil bilmez.
import { metinler } from "../i18n";
import { sayfaDili } from "../lib/yol";

const t = metinler(sayfaDili(Astro.url)).tema;
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label={t.dugme} data-acik={t.acik} data-koyu={t.koyu}>
  <span data-theme-label>{t.etiket}</span>
</button>

<style>
  .theme-toggle {
    font: 500 13px var(--f-body);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    padding: 6px 12px;
    border-radius: var(--r-pill);
    cursor: pointer;
    white-space: nowrap;
  }
  .theme-toggle:hover { border-color: var(--ink); }
</style>

<script>
  const KEY = "tema";
  const root = document.documentElement;
  const darkQuery = matchMedia("(prefers-color-scheme: dark)");

  function effectiveTheme(): "light" | "dark" {
    const chosen = root.dataset.theme;
    if (chosen === "light" || chosen === "dark") return chosen;
    return darkQuery.matches ? "dark" : "light";
  }

  function updateLabels() {
    const koyu = effectiveTheme() === "dark";
    document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((button) => {
      const label = button.querySelector("[data-theme-label]");
      if (label) label.textContent = (koyu ? button.dataset.acik : button.dataset.koyu) ?? "";
    });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const next = effectiveTheme() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try { localStorage.setItem(KEY, next); } catch {}
      updateLabels();
    });
  });

  darkQuery.addEventListener("change", updateLabels);
  updateLabels();
</script>
