---
// Basılı/basılı değil durumu olan filtre çipi. Davranışı kullanan script belirler;
// data-* nitelikleri olduğu gibi düğmeye geçer.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  basili: boolean;
  /** Renk token'ı (ör. "--c-tekmer"); verilirse çipin başında renkli nokta olur */
  renk?: string;
  sayi?: number;
}
const { basili, renk, sayi, ...rest } = Astro.props;
---

<button type="button" class="chip" aria-pressed={basili ? "true" : "false"} style={renk ? `--c:var(${renk})` : undefined} {...rest}>
  {renk && <i></i>}<slot />{sayi !== undefined && <small>{sayi}</small>}
</button>

<style>
  .chip {
    font: 500 13px var(--f-body);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    padding: 6px 12px 6px 10px;
    border-radius: var(--r-pill);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .chip:hover { border-color: var(--ink); }
  i { width: 10px; height: 10px; border-radius: 50%; background: var(--c); }
  small { font-family: var(--f-mono); color: var(--muted); }
  .chip[aria-pressed="true"] { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
  .chip[aria-pressed="false"] { color: var(--muted); }
  .chip[aria-pressed="false"] i { opacity: .35; }
</style>
