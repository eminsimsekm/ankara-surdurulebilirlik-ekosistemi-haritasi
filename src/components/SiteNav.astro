---
/*
  Üst menü, iki katman:
  - Ana satır: sitenin bölümleri.
  - Kurumlar alt satırı: kurum kategorileri; yalnızca Kurumlar bölümündeyken görünür.
    Kategoriler kategoriler.yaml'daki menuAdi/menuSira'dan gelir.
*/
import { metinler } from "../i18n";
import { getMenuKategorileri, kategoriYolu } from "../lib/content";
import { sayfaDili, yol } from "../lib/yol";

interface Baglanti {
  ad: string;
  yol: string;
}

const dil = sayfaDili(Astro.url);
const t = metinler(dil).menu;
const ANA_YOL = yol("/", dil);
const KURUMLAR_YOLU = yol("/kurumlar/", dil);

const kurumKategorileri: Baglanti[] = (await getMenuKategorileri(dil)).map((k) => ({
  ad: k.data.menuAdi!,
  yol: kategoriYolu(k, dil),
}));

const anaBaglantilar: Baglanti[] = [
  { ad: t.harita, yol: ANA_YOL },
  { ad: t.kurumlar, yol: KURUMLAR_YOLU },
  { ad: t.akademisyenler, yol: yol("/akademisyenler/", dil) },
  { ad: t.yatirimlar, yol: yol("/yatirimlar/", dil) },
  { ad: t.takvim, yol: yol("/takvim/", dil) },
  { ad: t.isbirlikleri, yol: yol("/isbirlikleri/", dil) },
  { ad: t.netzero, yol: yol("/netzero/", dil) },
];

const simdiki = Astro.url.pathname.replace(/\/?$/, "/");
const altinda = (hedef: string) => (hedef === ANA_YOL ? simdiki === ANA_YOL : simdiki.startsWith(hedef));
const kurumlardaMi = altinda(KURUMLAR_YOLU) || kurumKategorileri.some((k) => altinda(k.yol));

const anaAktif = (b: Baglanti) => (b.yol === KURUMLAR_YOLU ? kurumlardaMi : altinda(b.yol));
const altBaglantilar: Baglanti[] = [{ ad: t.tumu, yol: KURUMLAR_YOLU }, ...kurumKategorileri];
const altAktif = (b: Baglanti) => (b.yol === KURUMLAR_YOLU ? simdiki === KURUMLAR_YOLU : altinda(b.yol));
---

<nav class="site-nav" aria-label={t.bolumler}>
  <ul class="ana">
    {anaBaglantilar.map((b) => (
      <li>
        <a href={b.yol} aria-current={anaAktif(b) ? "page" : undefined}>
          {b.ad}
          {b.yol === KURUMLAR_YOLU && (
            <svg class:list={["ok", { acik: kurumlardaMi }]} viewBox="0 0 10 6" aria-hidden="true">
              <path d="M1 1l4 4 4-4" />
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>
</nav>

{kurumlardaMi && (
  <nav class="site-nav alt" aria-label={t.kurumKategorileri}>
    <ul>
      {altBaglantilar.map((b) => (
        <li><a href={b.yol} aria-current={altAktif(b) ? "page" : undefined}>{b.ad}</a></li>
      ))}
    </ul>
  </nav>
)}

<style>
  .site-nav { border-bottom: 2px solid var(--line); overflow-x: auto; scrollbar-width: none; }
  .site-nav::-webkit-scrollbar { display: none; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: nowrap; }
  /* Geniş ekranda tüm bağlantılar görünsün (alt satıra geçer); dar ekranda yatay kaydırılır */
  @media (min-width: 861px) { ul { flex-wrap: wrap; } }
  a {
    display: block;
    font: 600 14px var(--f-body);
    padding: 10px 16px;
    margin-bottom: -2px;
    border-bottom: 3px solid transparent;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color .15s, border-color .15s;
  }
  a:hover { color: var(--ink); }
  a[aria-current="page"] { color: var(--accent); border-bottom-color: var(--accent); }

  /* Kurumlar'ın alt menüsü olduğunu gösteren ok; alt menü açıkken yukarı döner */
  .ok {
    width: 10px;
    height: 6px;
    margin-left: 6px;
    vertical-align: middle;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform .15s;
  }
  .ok.acik { transform: rotate(180deg); }

  /* Alt satır: daha küçük, ana satırın altında hafif zeminli */
  .alt { background: var(--soft); border-bottom-width: 1px; border-radius: 0 0 var(--r-md) var(--r-md); }
  .alt a { font: 500 13px var(--f-body); padding: 8px 12px; margin-bottom: -1px; border-bottom-width: 2px; }
</style>
