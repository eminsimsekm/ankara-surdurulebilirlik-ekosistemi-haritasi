---
/*
  Radyal ekosistem haritası. Tamamı build sırasında çizilir:
  - geometri: lib/harita-yerlesim.ts
  - düğümler ve detayları: ./kaynaklar.ts
  - renkler CSS değişkeni olduğu için tema değişince yeniden çizim gerekmez
  Tarayıcıdaki script (scripts/harita.ts) yalnızca seçim, süzme ve soluklaştırma yapar.

  İki görünüm vardır. Genel görünümde her kategori bir dilimdir. Bir kategori
  seçilince yalnızca onun düğümleri kalır ve tüm daireye, düğümlerin altGrup'una
  (kurumlarda birincil alan) göre dilimlenerek yayılır. Her düğüm tek kategoriye
  ait olduğundan iki konumu vardır: cx/cy (genel) ve --dx/--dy farkı (kategori
  görünümü). Geçiş CSS transform'uyla yapılır; tarayıcıda geometri hesaplanmaz.

  Dilim etiketleri geniş ekranda yazıyla (kategori görünümünde tam ad, gerekirse
  birkaç satır), dar ekranda numarayla gösterilir; numaraların karşılığı haritanın
  altındaki lejanttadır (telefonda harita küçüldüğü için yazı okunmaz).
*/
import { getKategoriler } from "../../lib/content";
import FiltreCipleri from "../FiltreCipleri.astro";
import { haritaYerlesimi, HARITA_VIEWBOX, type DilimGirdisi, type HalkaAyari, type Yerlesim } from "../../lib/harita-yerlesim";
import { haritaDugumleri, type HaritaDugumu } from "./kaynaklar";

const [kategoriler, dugumler] = await Promise.all([getKategoriler(), haritaDugumleri()]);

const yerlesim = haritaYerlesimi(
  kategoriler.map((k) => ({
    anahtar: k.id,
    etiket: k.data.kisaAd,
    dugumIdleri: dugumler.filter((n) => n.kategori === k.id).map((n) => n.id),
  })),
);
const dugumById = new Map(dugumler.map((n) => [n.id, n]));

/** Kategori görünümünün dilimleri: altGrup'a göre, altGrup sırasıyla; altGrup'u olmayanlar kategorinin adıyla tek dilim. */
function altGrupDilimleri(kategoriId: string, varsayilanEtiket: string): DilimGirdisi[] {
  const gruplar = new Map<string, DilimGirdisi & { sira: number }>();
  for (const n of dugumler.filter((d) => d.kategori === kategoriId)) {
    const g: NonNullable<HaritaDugumu["altGrup"]> = n.altGrup ?? { id: kategoriId, etiket: varsayilanEtiket, sira: 0 };
    if (!gruplar.has(g.id)) gruplar.set(g.id, { anahtar: g.id, etiket: g.etiket, sira: g.sira, dugumIdleri: [] });
    gruplar.get(g.id)!.dugumIdleri.push(n.id);
  }
  return [...gruplar.values()].sort((a, b) => a.sira - b.sira);
}

// Kategori görünümünde düğüm az; halkalar dıştan başlar ki düğümler merkeze yığılmasın
const KATEGORI_HALKASI: HalkaAyari = { ilk: 140, son: 318, adim: 30 };

const kategoriGorunumleri: { kategori: (typeof kategoriler)[number]; girdiler: DilimGirdisi[]; yerlesim: Yerlesim }[] = kategoriler
  .filter((k) => dugumler.some((n) => n.kategori === k.id))
  .map((kategori) => {
    const girdiler = altGrupDilimleri(kategori.id, kategori.data.ad);
    return { kategori, girdiler, yerlesim: haritaYerlesimi(girdiler, KATEGORI_HALKASI) };
  });

/** Düğümün kategori görünümündeki konumunun genel konumdan farkı ve o görünümde girdiği dilim. */
const fark = new Map<string, { dx: number; dy: number; dilim: string }>();
for (const { yerlesim: ky } of kategoriGorunumleri) {
  for (const q of ky.dugumler) {
    const p = yerlesim.dugumler.find((d) => d.id === q.id)!;
    fark.set(q.id, { dx: Math.round((q.x - p.x) * 10) / 10, dy: Math.round((q.y - p.y) * 10) / 10, dilim: q.anahtar });
  }
}
const sayi = (kategori: string) => dugumler.filter((n) => n.kategori === kategori).length;
const varsayilan = (dugumler.find((n) => n.oneCikan) ?? dugumler[0])?.id;
const { merkez } = yerlesim;

/**
 * Etiketi kelime sınırından satırlara böler. Yan dilimlerin etiketi haritanın kenarına
 * doğru uzar ve ~13 karakterlik yer bulur; üst ve alttakiler ortalı olduğu için daha geniş.
 */
function satirlara(metin: string, hiza: "start" | "middle" | "end"): string[] {
  const en = hiza === "middle" ? 22 : 13;
  const satirlar: string[] = [];
  for (const kelime of metin.split(" ")) {
    const son = satirlar.at(-1);
    if (son && son.length + 1 + kelime.length <= en) satirlar[satirlar.length - 1] = `${son} ${kelime}`;
    else satirlar.push(kelime);
  }
  return satirlar;
}

/** Bir görünümün çizilecek her şeyi: dilim çizgileri, etiketler, dar ekran numaraları ve lejant. */
interface GorunumCizimi {
  anahtar: string; // "" = genel
  merkezYazi: string;
  /** Dilim vurgulanınca merkezde sayının altında yazan birim ("kurum", "akademisyen"…) */
  birim: string;
  /** Kategori görünümünde tek renk; genel görünümde her dilim kendi kategorisinin rengi */
  renk?: string;
  dilimler: (Yerlesim["dilimler"][number] & { satirlar: string[]; ad: string; sayi: number })[];
}

const gorunumler: GorunumCizimi[] = [
  {
    anahtar: "",
    merkezYazi: "ANKARA",
    birim: "kayıt",
    dilimler: yerlesim.dilimler.map((d, i) => {
      const k = kategoriler[i]!;
      return { ...d, satirlar: [k.data.kisaAd], ad: k.data.ad, sayi: sayi(k.id) };
    }),
  },
  ...kategoriGorunumleri.map(({ kategori, girdiler, yerlesim: ky }) => ({
    anahtar: kategori.id,
    merkezYazi: kategori.data.kisaAd,
    // Menüde yer alan kategoriler kurumdur; akademisyen kendi adıyla, diğerleri "kayıt"
    birim: kategori.data.menuSira !== undefined ? "kurum" : kategori.id === "akademisyen" ? "akademisyen" : "kayıt",
    renk: `--c-${kategori.id}`,
    dilimler: ky.dilimler.map((d, i) => {
      const g = girdiler[i]!;
      return { ...d, satirlar: satirlara(g.etiket, d.etiket.hiza), ad: g.etiket, sayi: g.dugumIdleri.length };
    }),
  })),
];
const SATIR_ARALIGI = 16;
---

<div class="harita" data-harita data-gorunum="genel" data-varsayilan={varsayilan} data-merkez-x={merkez.x}>
  <div class="araclar">
    <FiltreCipleri
      etiket="Kategori filtresi"
      parametre="kategori"
      tumuSayi={dugumler.length}
      secenekler={kategoriler
        .filter((k) => sayi(k.id) > 0)
        .map((k) => ({ deger: k.id, ad: k.data.ad, sayi: sayi(k.id), renk: `--c-${k.id}` }))}
    />
    <input type="search" class="ara" name="ara" data-harita-ara placeholder="Haritada ara: hidrojen, ODTÜ, atık…" aria-label="Haritada ara" />
  </div>

  <div class="izgara">
    <div class="kutu">
      <svg viewBox={HARITA_VIEWBOX} role="group" aria-label="Kategori dilimlerine ayrılmış Ankara ekosistem haritası">
        {yerlesim.halkalar.map((r) => <circle class="halka" cx={merkez.x} cy={merkez.y} r={r} />)}
        <circle class="merkez" cx={merkez.x} cy={merkez.y} r={yerlesim.merkezYaricap} />
        {/* Vurgulanan dilimin kayıt sayısı; vurgu yokken gizli, merkez yazısının yerini alır */}
        <g class="merkez-bilgi" aria-hidden="true">
          <text class="merkez-sayi" x={merkez.x} y={merkez.y + 6} text-anchor="middle" data-merkez-sayi></text>
          <text class="merkez-birim" x={merkez.x} y={merkez.y + 22} text-anchor="middle" data-merkez-birim></text>
        </g>

        {gorunumler.map((g) => (
          <g
            class:list={["gorunum", { acik: g.anahtar === "", kategoride: !!g.anahtar }]}
            data-gorunum-anahtari={g.anahtar}
            data-birim={g.birim}
            style={g.renk ? `--c:var(${g.renk})` : undefined}
          >
            <text class:list={["merkez-yazi", { "kategori-adi": !!g.anahtar }]} x={merkez.x} y={merkez.y + (g.anahtar ? 5 : 6)} text-anchor="middle">
              {g.merkezYazi}
            </text>
            {g.dilimler.map((d, i) => (
              <>
                {d.cizgi && <line class="dilim-cizgi" x1={d.cizgi.bas.x} y1={d.cizgi.bas.y} x2={d.cizgi.son.x} y2={d.cizgi.son.y} />}
                <g class="dilim" data-dilim={d.anahtar} style={g.renk ? undefined : `--c:var(--c-${d.anahtar})`}>
                  <path class="dilim-alan" d={d.alan} />
                  <text class="dilim-etiket" x={d.etiket.x} y={d.etiket.y + 4} text-anchor={d.etiket.hiza}>
                    {d.satirlar.map((s, j) => (
                      <tspan x={d.etiket.x} dy={j === 0 ? (-(d.satirlar.length - 1) * SATIR_ARALIGI) / 2 : SATIR_ARALIGI}>{s}</tspan>
                    ))}
                  </text>
                  <g class="dilim-no" aria-hidden="true">
                    <circle cx={d.etiket.x} cy={d.etiket.y} r="24" />
                    <text x={d.etiket.x} y={d.etiket.y + 10} text-anchor="middle">{i + 1}</text>
                  </g>
                </g>
              </>
            ))}
          </g>
        ))}

        {yerlesim.dugumler.map((p) => {
          const n = dugumById.get(p.id)!;
          const { dx, dy, dilim } = fark.get(p.id)!;
          return (
            <g
              class="node"
              tabindex="0"
              role="button"
              aria-label={n.ad}
              data-id={n.id}
              data-ad={n.ad}
              data-kategori={n.kategori}
              data-search={n.aramaMetni}
              data-dx={dx}
              data-dy={dy}
              data-dilim-genel={p.anahtar}
              data-dilim-kategori={dilim}
              style={`--c:var(--c-${n.kategori}); --dx:${dx}; --dy:${dy}`}
            >
              <circle class="vurus" cx={p.x} cy={p.y} r="11" />
              <circle class="nokta" cx={p.x} cy={p.y} r="7" />
              <title>{n.ad}</title>
            </g>
          );
        })}

        <text class="secim-etiket" data-secim-etiket></text>
      </svg>

      {/* Dar ekranda dilim numaralarının karşılığı; açık görünümünki gösterilir */}
      {gorunumler.map((g) => (
        <ol
          class:list={["lejant", { acik: g.anahtar === "" }]}
          data-gorunum-anahtari={g.anahtar}
          aria-label="Harita dilimleri"
          style={g.renk ? `--c:var(${g.renk})` : undefined}
        >
          {g.dilimler.map((d) => (
            <li style={g.renk ? undefined : `--c:var(--c-${d.anahtar})`}>
              {d.ad} <small>{d.sayi}</small>
            </li>
          ))}
        </ol>
      ))}
    </div>
    <aside class="panel" data-detay-panel aria-live="polite"></aside>
  </div>

  {dugumler.map(({ id, detay: { Bilesen, props } }) => (
    <template id={`detay:${id}`}>
      <Bilesen {...props} baslikSeviyesi="h2" />
    </template>
  ))}
</div>

<style>
  .araclar { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; justify-content: space-between; margin: 0 0 14px; }
  .araclar :global(.chips) { margin: 0; }

  .ara {
    font: 15px var(--f-body);
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--ink);
    min-width: 0;
    width: min(320px, 100%);
  }

  .izgara { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  @media (max-width: 860px) { .izgara { grid-template-columns: 1fr; } }

  .kutu { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 8px; }
  svg { width: 100%; height: auto; display: block; }

  .halka, .dilim-cizgi { fill: none; stroke: var(--line); }
  .merkez { fill: var(--soft); stroke: var(--line); }
  .merkez-yazi { fill: var(--ink); font: 800 18px var(--f-display); transition: opacity .2s; }
  .merkez-bilgi { opacity: 0; transition: opacity .2s; pointer-events: none; }
  .merkez-sayi { fill: var(--c, var(--ink)); font: 800 28px var(--f-display); font-variant-numeric: tabular-nums; }
  .merkez-birim { fill: var(--muted); font: 500 10px var(--f-mono); letter-spacing: .06em; text-transform: uppercase; }
  .harita[data-vurgu] .merkez-yazi { opacity: 0; }
  .harita[data-vurgu] .merkez-bilgi { opacity: 1; }
  .dilim-etiket { fill: var(--c); font: 600 12px var(--f-mono); letter-spacing: .04em; text-transform: uppercase; }
  .kategori-adi { fill: var(--c); font-size: 10px; letter-spacing: .02em; text-transform: uppercase; }
  /* Kategori görünümünde dilimler tam adla, birkaç satır olabilir: büyük harf ve mono yerine gövde yazısı */
  .kategoride .dilim-etiket { font: 600 14px var(--f-body); letter-spacing: 0; text-transform: none; }

  /* Dar ekran: harita ~0,4 ölçeğe küçülür, yazı okunmaz. Etiket yerine numara, karşılığı lejantta. */
  .dilim-no { display: none; }
  .dilim-no circle { fill: var(--surface); stroke: var(--c); stroke-width: 3; }
  .dilim-no text { fill: var(--ink); font: 700 28px var(--f-body); }
  .lejant { display: none; }
  @media (max-width: 700px) {
    .dilim-etiket { display: none; }
    .dilim-no { display: inline; }
    .lejant.acik {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 4px 12px;
      margin: 8px 4px 4px;
      padding: 10px 0 0 22px;
      border-top: 1px solid var(--line);
      font-size: 12.5px;
      line-height: 1.35;
    }
    .lejant li::marker { color: var(--c); font: 700 12px var(--f-body); }
    .lejant small { color: var(--muted); font: 500 11px var(--f-mono); }
    .kategori-adi { font-size: 16px; }
    .secim-etiket { font-size: 28px; stroke-width: 8px; }
  }

  /* Yalnızca açık görünümün çizgi ve etiketleri görünür (SVG'de `hidden` niteliği güvenilir değil) */
  .gorunum:not(.acik) { display: none; }

  .node { cursor: pointer; }
  .harita[data-gorunum="kategori"] .node { transform: translate(calc(var(--dx) * 1px), calc(var(--dy) * 1px)); }
  /* Başka kategorinin düğümü: görünmez ve Tab ile ulaşılamaz */
  .node.gizli { opacity: 0; visibility: hidden; }

  /*
    Fareyle üzerine gelinen dilim (scripts/harita.ts, .vurgulu): alanı hafifçe renklenip büyür,
    noktaları büyür, etiketi kalınlaşır; diğer dilimlerin noktaları solar. Dokunmatikte yok.
  */
  .dilim-alan {
    fill: var(--c);
    fill-opacity: 0;
    fill-rule: evenodd;
    transform-box: view-box;
    transform-origin: 360px 360px;
    transition: fill-opacity .25s ease, transform .25s ease;
  }
  .dilim.vurgulu .dilim-alan { fill-opacity: .1; transform: scale(1.04); }
  .dilim-etiket { transition: font-size .2s ease; }
  .dilim.vurgulu .dilim-etiket { font-weight: 800; font-size: 13.5px; }
  .kategoride .dilim.vurgulu .dilim-etiket { font-size: 15.5px; }
  .nokta { transition: r .2s ease; }
  .node.vurgulu .nokta { r: 9; }
  .node.soluk:not(.gizli):not(.sel):not(.dim) { opacity: .4; }
  @media (prefers-reduced-motion: reduce) {
    .dilim-alan, .dilim-etiket, .nokta { transition: none; }
    .dilim.vurgulu .dilim-alan { transform: none; }
  }
  /* Görünmez geniş daire: telefonda dokunma alanı (düğümler 22 birim aralıklı, 11 yarıçap çakışmaz) */
  .vurus { fill: transparent; }
  .nokta { fill: var(--c); stroke: var(--surface); stroke-width: 1.5; }
  /* Geçiş yalnızca ilk çizimden sonra (data-hazir): adresle kategori görünümünde açılan sayfa kaymaz */
  .harita[data-hazir] .node { transition: transform .45s ease, opacity .2s, visibility .2s; }
  @media (prefers-reduced-motion: reduce) { .harita[data-hazir] .node { transition: none; } }
  .node.dim { opacity: .14; }
  .node.sel .nokta { stroke: var(--ink); stroke-width: 2.5; }
  .node:focus-visible { outline: none; }
  .node:focus-visible .nokta { stroke: var(--accent); stroke-width: 3; }

  .secim-etiket {
    font: 600 12px var(--f-body);
    fill: var(--ink);
    pointer-events: none;
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 20px;
    position: sticky;
    top: calc(env(safe-area-inset-top, 0px) + 12px);
    max-height: calc(100vh - 24px);
    overflow-y: auto;
  }
  @media (max-width: 860px) { .panel { position: static; max-height: none; } }
</style>

<script>
  import "../../scripts/harita";
</script>
