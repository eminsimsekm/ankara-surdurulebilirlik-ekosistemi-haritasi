---
// Tek seçimli filtre çipleri ("Tümü" + seçenekler). Bir [data-filter-root] içine konur;
// öğeler data-facet-<parametre> ile eşleşir. Mantık scripts/list-filter.ts'te.
import Cip from "./Cip.astro";
import { metinler } from "../i18n";
import { sayfaDili } from "../lib/yol";

export interface FiltreSecenegi {
  deger: string;
  ad: string;
  sayi: number;
  renk?: string;
}

interface Props {
  etiket: string;
  secenekler: FiltreSecenegi[];
  tumuSayi: number;
  /** Seçimin adres çubuğunda tutulacağı parametre (ör. "universite") */
  parametre: string;
  /** Görünür grup başlığı; bir sayfada birden çok çip grubu varken gruplar ayırt edilsin diye */
  baslik?: string;
  /**
   * Bağlı olduğu çip grubunun parametresi (ör. "kategori"). Verilirse o gruptaki seçime göre
   * yalnızca öğesi olan çipler görünür ve sayıları seçime göre güncellenir.
   */
  bagli?: string;
}
const { etiket, secenekler, tumuSayi, parametre, baslik, bagli } = Astro.props;
const dil = sayfaDili(Astro.url);
const t = metinler(dil);
---

<div class="chips" role="group" aria-label={etiket} data-filter-facet={parametre} data-filter-bagli={bagli}>
  {baslik && <span class="baslik" aria-hidden="true">{baslik}</span>}
  <Cip basili={true} sayi={tumuSayi} data-filter-chip data-deger="">{t.ortak.tumu}</Cip>
  {secenekler.map((s) => (
    <Cip basili={false} renk={s.renk} sayi={s.sayi} data-filter-chip data-deger={s.deger}>{s.ad}</Cip>
  ))}
</div>

<style>
  .chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 14px; }
  /* Bağlı grupta öğesi kalmayan çip gizlenir (Cip'in display'i hidden'ı ezmesin) */
  .chips :global(.chip[hidden]) { display: none; }
  .baslik { font: 600 11px var(--f-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); min-width: 72px; }
</style>

<script>
  import "../scripts/list-filter";
</script>
