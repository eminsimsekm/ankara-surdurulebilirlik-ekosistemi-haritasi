---
// Sektöre göre yatırım tutarları: yatay çubuk grafik (sektor-yatirimlari-2025.yaml).
import { getSektorYatirimlari } from "../../lib/content";
import ExternalLink from "../ExternalLink.astro";

interface Props {
  baslik: string;
  not: string;
  kaynak?: string;
}
const { baslik, not, kaynak } = Astro.props;
const satirlar = await getSektorYatirimlari();
const enBuyuk = Math.max(...satirlar.map((s) => s.data.tutarMilyonDolar));
const tutar = (v: number) => (v < 1 ? v.toFixed(2) : v.toFixed(1)).replace(".", ",");
---

<figure class="grafik">
  <figcaption><h3>{baslik}</h3></figcaption>
  <ul>
    {satirlar.map(({ data: s }) => (
      <li class:list={{ vurgu: s.vurgu }}>
        <span>{s.ad}</span>
        <div class="iz"><div class="dolgu" style={`width:${((s.tutarMilyonDolar / enBuyuk) * 100).toFixed(1)}%`}></div></div>
        <span class="deger">{tutar(s.tutarMilyonDolar)} · {s.islem} işlem</span>
      </li>
    ))}
  </ul>
  <p class="not">{not} {kaynak && <ExternalLink href={kaynak}>Rapor</ExternalLink>}</p>
</figure>

<style>
  .grafik { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 14px 16px; margin: 0; }
  h3 { font-size: 16px; margin-bottom: 10px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 140px minmax(0, 1fr) 112px; gap: 10px; align-items: center; font-size: 13px; padding: 3px 0; }
  @media (max-width: 520px) { li { grid-template-columns: 104px minmax(0, 1fr) 100px; } }
  .iz { height: 14px; background: var(--soft); border-radius: 3px; overflow: hidden; }
  .dolgu { height: 100%; background: var(--muted); opacity: .55; }
  li.vurgu { font-weight: 600; }
  li.vurgu .dolgu { background: var(--c-yatirim); opacity: 1; }
  .deger { font-family: var(--f-mono); font-size: 12px; text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .not { font-size: 12px; color: var(--muted); margin: 8px 0 0; }
</style>
