---
// Markdown'dan gelen düzyazının (sayfalar/*.md gövdesi) tipografisi.
interface Props {
  /** "kutu": kenarlıklı bilgi kutusu */
  gorunum?: "duz" | "kutu";
}
const { gorunum = "duz" } = Astro.props;
---

<div class:list={["metin", gorunum]}><slot /></div>

<style>
  .metin { max-width: 80ch; font-size: 15px; }
  .metin :global(h2) { font-size: 20px; margin: 0 0 8px; }
  .metin :global(h3) { font-size: 16px; margin: 16px 0 6px; }
  .metin :global(p) { margin: 0 0 10px; }
  .metin :global(p:last-child) { margin-bottom: 0; }
  .metin :global(ul) { margin: 6px 0 10px; padding-left: 18px; }
  .metin :global(li) { margin: 3px 0; }
  .kutu {
    border: 1px solid var(--line);
    border-left: 3px solid var(--c-girisim);
    padding: 14px 16px;
    font-size: 14px;
    line-height: 1.55;
  }
  .kutu :global(h2) { font-size: 15px; }
</style>
